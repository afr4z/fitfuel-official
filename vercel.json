{
  "version": 2,
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/order",
      "destination": "/order.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/api/plans",
      "destination": "/api/public.js"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth.js"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin.js"
    },
    {
      "source": "/payment-success",
      "destination": "/payment-success.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "functions": {
    "api/webhook.js": {
      "maxDuration": 30,
      "memory": 256
    },
    "api/razorpay-webhook.js": {
      "maxDuration": 10,
      "memory": 128
    },
    "api/auth.js": {
      "maxDuration": 30,
      "memory": 128
    },
    "api/public.js": {
      "maxDuration": 10,
      "memory": 128
    },
    "api/admin.js": {
      "maxDuration": 30,
      "memory": 128
    },
    "api/web-order.js": {
      "maxDuration": 30,
      "memory": 128
    },
    "api/cron/commit-meals.js": {
      "maxDuration": 120,
      "memory": 256
    },
    "api/cron/notify-breakfast.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/cron/notify-lunch.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/cron/notify-dinner.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/cron/expiry-reminder.js": {
      "maxDuration": 60,
      "memory": 256
    },
    "api/cron/session-expiry.js": {
      "maxDuration": 30,
      "memory": 128
    }
  },
  "crons": [
    {
      "path": "/api/cron/commit-meals",
      "schedule": "15 14 * * *"
    },
    {
      "path": "/api/cron/notify-breakfast",
      "schedule": "30 14 * * *"
    },
    {
      "path": "/api/cron/notify-lunch",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/notify-dinner",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/expiry-reminder",
      "schedule": "0 8 * * *"
    }
  ]
}
