# FitFuel environment variables
# Copy to .env.local for local scripts. Production values live in Vercel.

# ── Core ──────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APP_URL=https://www.fitfuelnutrition.in
ADMIN_SECRET=
CRON_SECRET=

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

WHATSAPP_OTP_TEMPLATE=otp_code
WHATSAPP_BREAKFAST_TEMPLATE=breakfast_notification
WHATSAPP_LUNCH_TEMPLATE=lunch_notification
WHATSAPP_DINNER_TEMPLATE=dinner_notification
WHATSAPP_RESCHEDULED_TEMPLATE=rescheduled_meal
WHATSAPP_EXPIRY_TEMPLATE=expiry_reminder
WHATSAPP_SESSION_EXPIRED_TEMPLATE=session_expired
WHATSAPP_PAYMENT_CONFIRMED_TEMPLATE=payment_confirmed
WHATSAPP_PAYMENT_FAILED_TEMPLATE=payment_failed
WHATSAPP_KITCHEN_CLOSED_TEMPLATE=kitchen_closed
WHATSAPP_CANCELLED_TEMPLATE=subscription_cancelled
# Document-header template used when the 24-hour customer service window is closed.
WHATSAPP_INVOICE_TEMPLATE=invoice_ready

# ── Instagram (official Meta Graph API, Instagram Login) ─────────────────────
# Separate product from WhatsApp: different app credentials, different token,
# different permissions. See docs/instagram.md for the full setup walkthrough.
#
# These are the *Instagram* app ID and secret from
# App Dashboard → Instagram → API setup with Instagram login,
# NOT Settings → Basic → App ID / App Secret.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_VERIFY_TOKEN=

# Master kill switch. Set to false to stop all posting and replies without a
# redeploy; the webhook keeps returning 200 so Meta does not retry.
INSTAGRAM_ENABLED=true

# Public https image used for the daily menu post. The admin console can
# override it per date. Falls back to $APP_URL/instagram/menu.jpg.
INSTAGRAM_MENU_IMAGE_URL=

# Post to the comment thread as well as the DM ("Sent you a DM 🍽️").
INSTAGRAM_PUBLIC_COMMENT_REPLIES=false

# Reject webhooks whose X-Hub-Signature-256 does not match INSTAGRAM_APP_SECRET.
# Vercel parses the body before the handler runs, so enable this only after
# confirming signatures validate against your app in production.
INSTAGRAM_REQUIRE_SIGNATURE=false

# Replies allowed per Instagram user per hour.
INSTAGRAM_MAX_REPLIES_PER_HOUR=5

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Delivery pricing ─────────────────────────────────────────────────────────
# Delivery charges live in the delivery_settings table and are edited from
# Admin → Pricing → Delivery charges. These values are only for kitchen
# location, geocoding, and the rollout cutoff.
KITCHEN_LAT=17.2478673
KITCHEN_LNG=80.1496404
DELIVERY_GEOCODE_SUFFIX=Khammam, Telangana, India
DELIVERY_LAUNCH_AT=2026-10-28T07:45:21Z

# ── GST invoices ─────────────────────────────────────────────────────────────
# Company, GSTIN, tax rate, SAC, address, and invoice prefix live in the
# gst_settings table and are edited from Admin → Company. These are only
# operational settings, not company details.
GST_INVOICE_SAMPLE=false
INVOICE_STORAGE_BUCKET=invoices

# ── Other optional settings ──────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=5
RENEWAL_THRESHOLD_DAYS=2
BYPASS_DEADLINE_CHECK=false
