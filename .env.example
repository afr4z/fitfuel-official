# FitFuel environment variables
# Copy to .env.local for local scripts. Production values live in Vercel.

# ── Core ──────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APP_URL=https://fitfuel-official.vercel.app
ADMIN_SECRET=
CRON_SECRET=

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

WHATSAPP_OTP_TEMPLATE=otp_code
WHATSAPP_BREAKFAST_TEMPLATE=breakfast_notification
WHATSAPP_LUNCH_TEMPLATE=lunch_notification
WHATSAPP_DINNER_TEMPLATE=dinner_notification
WHATSAPP_RESCHEDULED_TEMPLATE=rescheduled_meal
WHATSAPP_EXPIRY_TEMPLATE=expiry_reminder
WHATSAPP_SESSION_EXPIRED_TEMPLATE=session_expired
WHATSAPP_PAYMENT_CONFIRMED_TEMPLATE=payment_confirmed
WHATSAPP_PAYMENT_FAILED_TEMPLATE=payment_failed
WHATSAPP_KITCHEN_CLOSED_TEMPLATE=kitchen_closed
WHATSAPP_CANCELLED_TEMPLATE=subscription_cancelled
# Document-header template used when the 24-hour customer service window is closed.
WHATSAPP_INVOICE_TEMPLATE=invoice_ready

# ── Razorpay ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Delivery pricing ─────────────────────────────────────────────────────────
DELIVERY_FREE_KM=3
DELIVERY_STANDARD_PER_MEAL=20
DELIVERY_LONG_PLAN_PER_MEAL=15
DELIVERY_LONG_PLAN_MIN_DAYS=20
DELIVERY_UNKNOWN_POLICY=charge
KITCHEN_LAT=17.2478673
KITCHEN_LNG=80.1496404
DELIVERY_GEOCODE_SUFFIX=Khammam, Telangana, India
DELIVERY_LAUNCH_AT=2026-10-28T07:45:21Z

# ── GST invoices ─────────────────────────────────────────────────────────────
# Set the seller GSTIN to activate invoicing. Set GST_INVOICE_ENABLED=false to
# pause it explicitly.
GST_INVOICE_ENABLED=false
GST_INVOICE_SAMPLE=false
GST_INVOICE_PREFIX=FF
GST_SELLER_LEGAL_NAME=Jadpod Fitness Private Limited
GST_SELLER_TRADE_NAME=FitFuel Nutrition
# Separate address lines with | (pipe) or newlines.
GST_SELLER_ADDRESS_LINES=3rd Floor, 402, YK Arcade|Wyra Road, Near Surabhi Hospital|Khammam, Telangana 507002
GST_SELLER_GSTIN=
GST_SELLER_PAN=
GST_SELLER_EMAIL=hello@fitfuelnutrition.com
GST_SELLER_PHONE=
GST_SELLER_STATE_CODE=36
GST_INVOICE_TERMS=We declare that this invoice shows the actual price of the goods/services described and that all particulars are true and correct.

# Prices stored in the plans are GST-inclusive. The invoice back-calculates the
# taxable value and shows CGST/SGST (or IGST) inside that total.
GST_RATE=5
GST_SAC=996331
GST_DELIVERY_SAC=996331
INVOICE_STORAGE_BUCKET=invoices

# ── Other optional settings ──────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=5
RENEWAL_THRESHOLD_DAYS=2
BYPASS_DEADLINE_CHECK=false
